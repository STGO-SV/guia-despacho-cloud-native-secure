# DATO DEL OPERADOR: usuario/organizacion que contiene las imagenes publicadas.
# No usar la contrasena de Docker Hub. El token se configura solo en GitHub/EC2.
DOCKERHUB_USERNAME=DOCKERHUB_USER
IMAGE_TAG=latest

# VALORES PUBLICOS CONFIRMADOS: resource servers Azure B2C.
# AZURE_ISSUER_URI coincide literalmente con iss y con issuer de la metadata OIDC.
AZURE_ISSUER_URI=https://duocssaezcloudnative.b2clogin.com/c1b3705d-e099-41bf-9501-b1a51343af10/v2.0/
AZURE_JWK_SET_URI=https://duocssaezcloudnative.b2clogin.com/duocssaezcloudnative.onmicrosoft.com/b2c_1_guias_signupsignin/discovery/v2.0/keys
AZURE_CLIENT_ID=75d470b0-2bfb-4989-9d81-aa1805f3b546
AZURE_ROLES_CLAIM=extension_RolGuia

# CREDENCIALES INTERNAS: Santiago debe generar valores robustos.
RABBITMQ_USERNAME=CHANGE_ME_RABBITMQ_USER
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_LISTENER_AUTO_STARTUP=true

# PERSISTENCIA H2 ACADEMICA: las URLs/usuarios son configuracion; las claves son secretas.
CURSOS_DB_URL=jdbc:h2:file:/data/cursos
CURSOS_DB_USERNAME=sa
CURSOS_DB_PASSWORD=CHANGE_ME_CURSOS_DB_PASSWORD
INSCRIPCIONES_DB_URL=jdbc:h2:file:/data/inscripciones
INSCRIPCIONES_DB_USERNAME=sa
INSCRIPCIONES_DB_PASSWORD=CHANGE_ME_INSCRIPCIONES_DB_PASSWORD

# OPCIONAL: S3 esta deshabilitado. Si se omiten, Compose usa defaults no operativos.
# No se requieren AWS access keys mientras AWS_S3_UPLOAD_ENABLED=false.
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=eft-cursos-materiales-demo

# VALORES PUBLICOS CONFIRMADOS: endpoint EC2 actual.
FRONTEND_ALLOWED_ORIGIN=http://ec2-3-89-27-87.compute-1.amazonaws.com
FRONTEND_PORT=80

# VALORES PUBLICOS CONFIRMADOS: SPA Azure B2C.
# GESTION_GUIAS/DESCARGA_GUIAS son roles; access_as_user es el scope OAuth2.
B2C_CLIENT_ID=b91690e3-e8f3-435c-8aaa-6e8eb7f263ed
B2C_AUTHORITY=https://duocssaezcloudnative.b2clogin.com/duocssaezcloudnative.onmicrosoft.com/B2C_1_guias_signupsignin
B2C_KNOWN_AUTHORITY=duocssaezcloudnative.b2clogin.com
B2C_REDIRECT_URI=http://ec2-3-89-27-87.compute-1.amazonaws.com/
B2C_SCOPE=https://duocssaezcloudnative.onmicrosoft.com/75d470b0-2bfb-4989-9d81-aa1805f3b546/access_as_user

# PUBLICO: vacio usa el proxy Nginx del mismo origen hacia bff-service.
BFF_BASE_URL=
